# Canonical origin. Change to the exact HTTPS deployment URL outside local development.
APP_URL=http://localhost:3000
# Server-side only, not NEXT_PUBLIC. Start the Python service separately.
BEREADY_API_URL=http://127.0.0.1:8000
# Managed account provider. Empty means clearly unavailable, never fake local accounts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only database writer credential. Never use NEXT_PUBLIC_ or expose it to browsers.
SUPABASE_SERVICE_ROLE_KEY=
# These public-named fallbacks are supported only if the server helper documents them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hosted checkout for an optional operator pilot. Plans stay free to view.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Dedicated private ledger role, not a browser key or ordinary user connection.
# Grant only INSERT/SELECT on private.billing_webhook_events, require TLS in production.
BILLING_DATABASE_URL=
